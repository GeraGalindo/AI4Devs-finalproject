# Copia este archivo como backend/.env. No contiene secretos: son valores de desarrollo local.
# Obligatoria: development, test o production. Los scripts dev, test y test:integration la fijan.
NODE_ENV=development
PORT=3000
# Origen exacto de la SPA para la comprobación CSRF. En development/test vale por defecto
# http://localhost:5173 (proxy de Vite); en production es obligatoria y debe ser https.
APP_ORIGIN=http://localhost:5173
# La cookie de sesión no se configura: es "session" sin Secure en development/test y
# "__Host-session" con Secure en production (DEV-003/DEV-004).
# Secreto HS256 de los JWT de sesión (DEV-004). En development/test, si no se define, se usa un
# valor fijo y público solo para desarrollo. En production es obligatorio: al menos 32 bytes,
# aleatorio y nunca versionado. Genéralo con `openssl rand -base64 48`. Sin él no arranca.
# JWT_SECRET=
# Coincide con docker-compose.yml
DATABASE_URL=postgres://calicoach:calicoach@localhost:5432/calicoach
# Base desechable para las pruebas de integración: debe terminar en _test y ser distinta de DATABASE_URL.
# Las pruebas la crean si no existe y le aplican las migraciones (prisma migrate deploy).
TEST_DATABASE_URL=postgres://calicoach:calicoach@localhost:5432/calicoach_test
